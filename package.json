{
  "name": "performance-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start:server": "cd server && npx tsx app.ts",
    "start:client": "npm run dev -w client",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "build": "concurrently \"npm run build -w client\" \"npm run build -w server\"",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "test": "concurrently \"npm run test -w client\" \"npm run test -w server\"",
    "test:client": "npm run test -w client",
    "test:server": "npm run test -w server",
    "lint": "npm run lint -w client",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --config client/eslint.config.js"
    ],
    "server/src/**/*.{js,ts}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
