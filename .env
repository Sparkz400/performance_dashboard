NODE_ENV=development

# Server configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=postgres
DB_MAX_POOL=10

# OPC UA configuration
OPCUA_IP=localhost
OPCUA_PORT=4840
OPCUA_RESOURCE_PATH=/UA/MyLittleServer
OPCUA_SECURITY_FALLBACK_ENABLED=true

# Certificate Configuration
OPCUA_PKI_DIR=./certificates
OPCUA_APPLICATION_NAME=Monitoring-Dashboard-Client
OPCUA_APPLICATION_URI=urn:monitoring-dashboard-client
OPCUA_SECURITY_MODE=None
OPCUA_SECURITY_POLICY=None
AUTO_ACCEPT_CERTIFICATES=false

# Health Checks
DB_HEALTH_CHECK_INTERVAL=60000
OPCUA_HEALTH_CHECK_INTERVAL=30000

# Performance
POLLING_INTERVAL_MS=20000

# Admin
# ADMIN_API_KEY=your_secure_admin_key # Example

# Queue
OPCUA_BATCH_SIZE=200
OPCUA_QUEUE_DELAY=250