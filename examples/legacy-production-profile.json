{
  "version": 1,
  "name": "Owned legacy register fixture",
  "endpointModel": "Owned Modbus simulator offsets 0-6; not a vendor register map",
  "signals": {
    "state": { "nodeKey": "ProductionState", "namespaceUri": "urn:performance-dashboard:owned-legacy:v1", "identifier": "s=ProductionState", "dataType": "Double", "unit": null, "scale": 1 },
    "total": { "nodeKey": "ProductionCount", "namespaceUri": "urn:performance-dashboard:owned-legacy:v1", "identifier": "s=ProductionCount", "dataType": "Double", "unit": "parts", "scale": 1 },
    "good": { "nodeKey": "GoodCount", "namespaceUri": "urn:performance-dashboard:owned-legacy:v1", "identifier": "s=GoodCount", "dataType": "Double", "unit": "parts", "scale": 1 },
    "reject": { "nodeKey": "RejectCount", "namespaceUri": "urn:performance-dashboard:owned-legacy:v1", "identifier": "s=RejectCount", "dataType": "Double", "unit": "parts", "scale": 1 }
  },
  "states": { "running": [1], "idle": [0], "fault": [2], "planned": [3] },
  "idealCycleMs": 1000,
  "maxGapSeconds": 5,
  "counterPolicy": "reject-decrease"
}
