# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=55432
DB_USER=dashboard
DB_PASSWORD=dashboard-local
DB_NAME=performance_dashboard
# DB_READ_REPLICA_URLS=             # Comma-separated PostgreSQL replica URLs
# REDIS_URL=                        # Optional Redis connection URL
# DB_MAX_POOL=10                    # Max database pool size
# DB_CONNECTION_TIMEOUT=10000       # Connection timeout (ms)
# DB_IDLE_TIMEOUT=30000             # Idle connection timeout (ms)
# DB_HEALTH_CHECK_INTERVAL=60000    # Health check interval (ms, 0 to disable)
# DB_REPLICA_MAX_POOL=10            # Replica pool size
# DB_QUERY_SLOW_THRESHOLD_MS=250    # Slow query threshold (ms)
# DB_QUERY_METRICS_MAX_SAMPLES=250  # Query samples retained in memory

# ─── OPC UA ───────────────────────────────────────────────────────────────────
OPCUA_IP=localhost
OPCUA_PORT=4841
OPCUA_RESOURCE_PATH=/UA/MyLittleServer
OPCUA_SPOOL_PATH=data/measurements.sqlite
# Choose from measured backlog bytes and disk runway; see docs/UNATTENDED_OPERATION.md
# OPCUA_SPOOL_MAX_ENTRIES=1000000    # Pending measurements at which acquisition stops
# OPCUA_SPOOL_RESERVE_MB=64          # Free disk space kept beside the spool
# COLLECTOR_BACKLOG_ALERT_SECONDS=60 # Backlog age that raises an alert (also at 80% capacity)
# STORAGE_RUNWAY_ALERT_DAYS=2        # Projected days to the reserve that raise an alert
OPCUA_PKI_DIR=certificates
MACHINE_SECRETS_KEY_FILE=data/machine-secrets.key
# ENABLE_LEGACY_GATEWAY=false      # Opt-in read-only adapter; see docs/LEGACY_GATEWAY.md
SEED_ADMIN_PASSWORD=replace-with-a-unique-password
# OPCUA_RESOURCE_PATH=              # OPC UA resource path (can be empty)
OPCUA_SECURITY_MODE=None            # None | Sign | SignAndEncrypt
OPCUA_SECURITY_POLICY=None
# Security fallback and automatic trust are disabled; explicitly review certificates.
# OPCUA_PKI_DIR=                    # Custom path for OPC UA PKI certificates
# OPCUA_APPLICATION_NAME=NodeOPCUA-Client
# OPCUA_CERT_ORG_NAME=OpenSource
# OPCUA_CERT_COUNTRY=US             # 2-letter country code for self-signed cert
# OPCUA_CERT_LOCALITY=Somewhere
# OPCUA_CERT_STATE=State
# OPCUA_HEALTH_CHECK_INTERVAL=30000 # OPC UA health check interval (ms)

# ─── Secrets (CHANGE THESE IN PRODUCTION) ────────────────────────────────────
COOKIE_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info                      # error | warn | info | http | verbose | debug | silly

# ─── Security ────────────────────────────────────────────────────────────────
# ADMIN_API_KEY=                    # API key for admin/debug endpoints

# ─── Single sign-on (OIDC, off unless OIDC_ISSUER is set) ─────────────────────
# OIDC_ISSUER=https://idp.example.com/realms/plant   # HTTPS issuer identifier
# OIDC_CLIENT_ID=performance-dashboard
# OIDC_CLIENT_SECRET=                # confidential client secret
# OIDC_REDIRECT_URI=https://dashboard.example.com/api/v1/auth/oidc/callback
# OIDC_CA_FILE=                      # pin a private CA for the IdP; default: system trust
# OIDC_SCOPES=openid profile email groups
# OIDC_GROUPS_CLAIM=groups
# OIDC_DISPLAY_NAME=Single sign-on
# OIDC_MAX_SESSION_HOURS=8           # sessions return to the IdP after this age
# LOCAL_RECOVERY_ACCOUNTS=           # comma-separated local accounts allowed a password with SSO on
# RATE_LIMIT_WINDOW_MS=900000       # Rate limit window (ms)
# RATE_LIMIT_MAX_REQUESTS=1000      # Max requests per window
# ALLOW_PRIVATE_OUTBOUND_URLS=false # Allow outbound HTTP(S) calls to localhost/private hosts

# ─── OPC UA Queue ────────────────────────────────────────────────────────────
# OPCUA_BATCH_SIZE=100              # Batch size for OPC UA data inserts
# OPCUA_QUEUE_DELAY=500             # Queue processing loop delay (ms)
# OPCUA_QUEUE_WARN_THRESHOLD=10000  # Queue size warning threshold
# MAX_QUEUE_SIZE=100000             # Maximum queue size

# ─── Observability (OpenTelemetry) ────────────────────────────────────────────
# OTEL_ENABLED=false                # Enable OpenTelemetry tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=performance-dashboard-server

# Mail for scheduled PDF reports and alarm email destinations (optional; unset disables email)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=report-user
# SMTP_PASS=set-a-private-password
# SMTP_FROM=reports@example.com
# Remove stored report PDFs older than this many days (unset keeps every PDF)
# REPORT_RETENTION_DAYS=365
